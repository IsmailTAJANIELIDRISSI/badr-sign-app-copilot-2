BADR_PASSWORD=
EDGE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
BADR_CDP_PORT=9222
BADR_PROFILE_DIR=C:/Temp/badr-edge-profile
BADR_BUREAU_CODE=301
BADR_REGIME_CODE=010
BADR_YEAR=2026

HEADLESS=false
SLOW_MO=50
TIMEOUT=120000
PORT=3001
DUMS_DIR=./dums
OUTPUTS_DIR=./outputs
LOGS_DIR=./logs
SIGNED_LTAS_DIR=./outputs

# ── Email notification (sent when an LTA folder is marked READY) ──────────────
# Subject: "MAWB {ltaRef} ({n} DUM)", empty body, all signed PDFs attached.
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tajanielidrissi.ismail@gmail.com
# Gmail app password (not the account password).
EMAIL_PASS=qxis hjta gsyr anon
EMAIL_FROM=tajanielidrissi.ismail@gmail.com
# ── RECIPIENTS — REQUIRED. Set them HERE only ────────────────────────────────
# Recipients exist ONLY in .env. server/config.js has no list at all, so there
# is nothing to merge-conflict when the app auto-pulls on startup.
#
# ⚠️ If EMAIL_TO is empty, NO email is sent (logged: "EMAIL_TO is empty").
#    That is deliberate — a missing list must never silently fall back to the
#    real team. Every machine states its own recipients explicitly.
#
# Separate with ; , or newline. Plain addresses or Outlook paste both work:
#   EMAIL_TO=a@x.com; b@y.com
#   EMAIL_TO=Nouhaila ELALLALI <nouhaila.elallali@medafrica-log.com>; Imad <imad.amoudi@medafrica-log.com>

# --- TEST machine: send only to yourself ---
EMAIL_TO=cursorcompte06@gmail.com; nouhaila.elallali@medafrica-log.com; nouhaila.orfane@medafrica-log.com; OUSSAMA.FARIS@medafrica-log.com; medafrica.logistics.express@gmail.com

EMAIL_CC=ismail.tajani@medafrica-log.com

# --- PRODUCTION machine: comment out the two lines above and use these ---
# EMAIL_TO=Abderazzak.tamraoui@medafrica-log.com; abdelhak.tachrify@medafrica-log.com; nouhaila.elallali@medafrica-log.com; nouhaila.orfane@medafrica-log.com; OUSSAMA.FARIS@medafrica-log.com; ahmed.baazzouz@medafrica-log.com; imane.hamadi@medafrica-log.com
# EMAIL_CC=imad.amoudi@medafrica-log.com; hamza.kninis@medafrica-log.com

# ── WhatsApp alerts (PROBLEM folders, errors, chrono timeouts) ────────────────
# Provider: callmebot (free, self-notifications only).
# Setup: add +34 621 331 709 to contacts, send it "I allow callmebot to send me
# messages" on WhatsApp, then paste the API key it replies with below.
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=callmebot
# International format, no "+" and no leading 0 (0688711066 -> 212688711066).
WHATSAPP_PHONE=212688711066
WHATSAPP_CALLMEBOT_APIKEY=

# Chrono rule: 16 DUMs ≈ 20 min => 1.25 min/DUM. Alert if an LTA runs longer.
LTA_MINUTES_PER_DUM=1.25
